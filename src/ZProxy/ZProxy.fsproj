<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Crypto.fs" />
    <Compile Include="Users.fs" />
    <Compile Include="Statistics.fs" />
    <Compile Include="Contracts.fs" />
    <Compile Include="Plugins.fs" />
    <Compile Include="Options.fs" />
    <Compile Include="HttpUtils.fs" />
    <Compile Include="OmpMetadata.fs" />
    <Compile Include="Flow.fs" />
    <Compile Include="Zstd.fs" />
    <Compile Include="Frame.fs" />
    <Compile Include="HttpWire.fs" />
    <Compile Include="OmpWorker.fs" />
    <Compile Include="Handshake.fs" />
    <Compile Include="Tunnel.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Upstream.fs" />
    <Compile Include="Metering.fs" />
    <Compile Include="Management.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Omp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
