{
  "$comment": "Default composable route preset: keyed-model leaves, fallback, random and rating nodes. All time windows are UTC; Mainland China public holidays come from holidays-cn.json. Policy data lives in presets: model references and tiers here, ranking weights in ranking.json, vendor off-peak schedules in offpeak.json, and pricing in rates.json. clientOnlyPrefix is the route-id namespace the Lazy Router owns. No concrete model id, model-family pattern, route-id prefix, off-peak schedule, or ranking weight is hardcoded in routing code. Effort is passthrough on every route node: the client's reasoning/thinking level is preserved.",
  "contextWindow": 500000,
  "maxOutputTokens": 64000,
  "clientOnlyPrefix": "lazy/",
  "modelTraits": {
    "$comment": "Minimal capability corrections for channels whose models.yml entry omits them. kuaipao/claude-sonnet-5-5 is the same model id as commandcode/claude-sonnet-5-5, whose live catalog row declares contextWindow 1000000, maxTokens 65536, and text+image input. No effort list is declared: every route passes the requested reasoning level through.",
    "kuaipao/claude-sonnet-5-5": {
      "contextWindow": 1000000,
      "maxTokens": 65536,
      "input": ["text", "image"],
      "reasoning": true
    }
  },
  "providerHeaderTimeouts": {
    "commandcode": 1800000
  },
  "maxInFlight": {
    "ollama-cloud": 3,
    "mistral/deepseek-v4-1-flash-1017": 60,
