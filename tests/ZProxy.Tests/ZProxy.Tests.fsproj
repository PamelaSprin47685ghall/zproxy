<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HttpWireTests.fs" />
    <Compile Include="UsersTests.fs" />
    <Compile Include="StatisticsTests.fs" />
    <Compile Include="ManagementTests.fs" />
    <Compile Include="ProtocolTests.fs" />
    <Compile Include="CommandTests.fs" />
    <Compile Include="HttpUtilsTests.fs" />
    <Compile Include="PluginTests.fs" />
    <Compile Include="OmpMetadataTests.fs" />
    <Compile Include="MeteringTests.fs" />
    <Compile Include="FlowTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="EndToEndTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZProxy\ZProxy.fsproj" />
  </ItemGroup>

</Project>
